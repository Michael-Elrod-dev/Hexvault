{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hexvault",
  "version": "1.0.0",
  "identifier": "com.elrod.hexvault",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Hexvault",
        "width": 520,
        "height": 1030,
        "minWidth": 380,
        "minHeight": 400,
        "resizable": true,
        "center": true,
        "theme": "Dark",
        "backgroundColor": "#1a1b1e",
        "decorations": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' asset: http://asset.localhost https://ddragon.leagueoflegends.com; font-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
