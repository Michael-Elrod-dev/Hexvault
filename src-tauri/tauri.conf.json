{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LoL-Info",
  "version": "3.0.0",
  "identifier": "com.elrod.lolinfo",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "League Account Manager",
        "width": 520,
        "height": 1030,
        "minWidth": 380,
        "minHeight": 400,
        "resizable": true,
        "center": true,
        "theme": "Dark",
        "backgroundColor": "#1a1b1e",
        "decorations": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "C:/Users/*/AppData/Roaming/LoLinfo/portraits/*",
          "**/LoLinfo/portraits/*"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
